{#
/**
 * @file
 * The Index: the search page at /v2/search.
 *
 * Styles and script: palefire/index-search in the theme. Without JavaScript
 * the filters sit in the page with an Apply button, and a late section offers
 * a link to the source's own list. With it, filters apply as they're chosen
 * from 62rem, and open in a drawer on smaller screens.
 *
 * Variables:
 * - query, mode: the current search.
 * - action: the forms' address.
 * - modes: [label, url, current], the tabs.
 * - kept: [name, value] for each chosen filter and the sort, sent again with
 *   a new search.
 * - filters: [title, name, single, about, options: [label, value, count, checked]].
 *   The Source group also has all: [label, checked], its All sources row.
 *   single: one choice, as round buttons. about: [label, text], what each source
 *   is, opened from the group's title. count is
 *   NULL for a source that's only counted by searching it. A group with years
 *   instead of options is a year range: [from, to].
 * - chips: [label, url], the chosen filters as links that remove them.
 * - clear_url: the search with no filters.
 * - selected_count: how many filters are chosen.
 * - total: the list's total, when there's one list.
 * - capped: there may be more than the total, which is as far as a service reads.
 * - sort, sorts: the current sort and those on offer (value => label).
 * - links: [label, url], searches elsewhere.
 * - via: the service behind a chosen source: [label, url, also: [label, url]].
 *   A section can have its own.
 * - sections: [key, label, about, via, count, list or late_url and full_url].
 *   count is how many it found, as words ("20 results"); empty on a late one.
 * - answer: a short answer above the results, or NULL: [key, title,
 *   locations [lid, name], links [label, url, external]].
 * - list: one list, when a source is chosen or the mode is merged.
 * - list_title: the list's visible name, when sections lead above it. It then
 *   carries its own total and sort, which don't speak for those sections.
 * - list_source: the source whose place in a visitor's order the list takes.
 * - notice: a message about this search.
 */
#}
{% import _self as index %}
{% macro sort(sorts, current) %}
  <div class="pf-index__sort">
    <label for="pf-index-sort">{{ 'Sort by'|t }}</label>
    <select id="pf-index-sort" name="sort" form="pf-index-filter-form">
      {% for value, label in sorts %}
        <option value="{{ value }}"{% if value == current %} selected{% endif %}>{{ label }}</option>
      {% endfor %}
    </select>
  </div>
{% endmacro %}
{% macro via(via) %}
  <p class="pf-index-via">{{ 'Go to'|t }} <a href="{{ via.url }}">{{ via.label }}<svg class="pf-index-row__out" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M7 17 17 7M9 7h8v8"/></svg><span class="visually-hidden"> {{ '(another site)'|t }}</span></a>{% for other in via.also %}<span aria-hidden="true"> · </span>{{ 'Also try the'|t }} <a href="{{ other.url }}">{{ other.label }}<svg class="pf-index-row__out" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M7 17 17 7M9 7h8v8"/></svg><span class="visually-hidden"> {{ '(another site)'|t }}</span></a>{% endfor %}</p>
{% endmacro %}
{# data-no-swup on whatever changes the search: js/index-search.js swaps the
   results for those, and Swup would prefetch them on hover, running a whole
   search each time. Result links stay Swup's. #}
<div class="pf-index" data-pf-index>
  <header class="pf-index__head">
    <p class="pf-index__kicker">{{ 'LSU Libraries'|t }}<span class="visually-hidden">, </span><span class="pf-index__kicker-place">{{ 'Search'|t }}</span></p>
    <h1 class="pf-index__title">{{ 'Combined Search'|t }}</h1>
    <p class="pf-index__lede">{{ 'Search the catalog, articles and ebooks, databases, archives and library pages at once.'|t }}</p>
    <form class="pf-index__form" role="search" method="get" action="{{ action }}">
      <label class="visually-hidden" for="pf-index-q">{{ 'Search LSU Libraries'|t }}</label>
      <div class="pf-index__field">
        {# The clear button is the theme's (js/index-search.js shows it while
           the field has words); without script it stays hidden. #}
        <span class="pf-index__entry">
          <input class="pf-index__input" type="search" id="pf-index-q" name="q" value="{{ query }}" maxlength="128" autocomplete="off" enterkeyhint="search">
          <button class="pf-index__erase" type="button" data-pf-index-erase hidden><span class="visually-hidden">{{ 'Clear search'|t }}</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="m7 7 10 10M17 7 7 17"/></svg></button>
        </span>
        {% if mode != 'all' %}<input type="hidden" name="mode" value="{{ mode }}">{% endif %}
        {# The chosen filters and sort, so a new search keeps them. #}
        {% for field in kept %}<input type="hidden" name="{{ field.name }}" value="{{ field.value }}">{% endfor %}
        <button class="pf-index__submit" type="submit">{{ 'Search'|t }}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true" focusable="false"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m15.5 15.5 5 5"/></svg></button>
      </div>
    </form>
    <div class="pf-index__bar">
      <nav class="pf-index__modes" aria-label="{{ 'What to search'|t }}" data-no-swup>
        <ul role="list">
          {% for link in modes %}
            <li><a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.label }}</a></li>
          {% endfor %}
        </ul>
      </nav>
      {# How to write a search, in the glossary's card, its right edge on the
         button's: each example on a line of its own beside what it does.
         SearchTerms reads all of it. #}
      <button class="pf-index__about-open pf-index__tips-open" type="button" popovertarget="pf-index-tips" style="anchor-name:--pf-index-tips"><span class="pf-index__link-icon" aria-hidden="true">{{ source('libraries/fontawesome-pro/svgs/duotone/lightbulb.svg', ignore_missing = true)|raw }}</span><span class="pf-index__link-text">{{ 'Search tips'|t }}</span></button>
      <div class="pf-term__card pf-index__tips" id="pf-index-tips" popover style="position-anchor:--pf-index-tips" aria-labelledby="pf-index-tips-title">
        <div class="pf-index__tips-head">
          <p class="pf-term__name" id="pf-index-tips-title">{{ 'Search tips'|t }}</p>
          <button class="pf-index__tips-close" type="button" popovertarget="pf-index-tips" popovertargetaction="hide">{{ 'Close'|t }}</button>
        </div>
        <dl>
          <dt><code>"barry allen"</code></dt>
          <dd>{{ 'These words together, in this order. Library pages and finding aids still find the words anywhere in a record.'|t }}</dd>
          <dt><code>econom*</code></dt>
          <dd>{{ 'Words that start with these letters: economics, economy. Three letters or more before the *.'|t }}</dd>
          <dt><code>cotton AND sugar</code> <code>cotton OR sugar</code> <code>cotton NOT sugar</code></dt>
          <dd>{{ 'Both words, either word, or the first without the second. AND, OR and NOT go in capitals. A minus sign (‑sugar) also leaves a word out, and parentheses group words.'|t }}</dd>
          <dt><code>author:faulkner</code> <code>title:"light in august"</code> <code>subject:mississippi</code></dt>
          <dd>{{ 'Words in one field. The Catalog takes one field to a search. On library pages, author finds oral histories by the person interviewed or interviewing.'|t }}</dd>
          <dt><code>year:1862</code> <code>year:1860-1865</code></dt>
          <dd>{{ 'Published in those years, in the Catalog and Discovery. It fills in the Year published filter.'|t }}</dd>
          <dt><code>"PS3511 .A86"</code></dt>
          <dd>{{ 'A call number, in quotes, in the Catalog.'|t }}</dd>
        </dl>
        <p>{{ 'Research guides read words only. When a source can’t use part of a search, its results say what it searched for instead.'|t }}</p>
      </div>
    </div>
  </header>

  <div class="pf-index__main" data-pf-index-main tabindex="-1">
  {% if not query %}
    <p class="pf-index__prompt">{{ 'Enter a word or two to begin.'|t }}</p>
  {% else %}
    {% if notice %}
      <p class="pf-index__notice" role="status">{{ notice }}</p>
    {% endif %}

    <div class="pf-index__body" data-pf-index-body>
      <button class="pf-index__filters-open" type="button" data-pf-index-open aria-haspopup="dialog">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M4 7h16M7 12h10M10 17h4"/></svg>
        <span class="pf-index__filters-label">{{ 'Filters'|t }}</span>
        {%- if selected_count %}<span class="pf-index__filters-count"><span class="visually-hidden">, </span>{{ selected_count }}<span class="visually-hidden"> {{ 'chosen'|t }}</span></span>{% endif %}
      </button>

      {# A <dialog> so the drawer gets focus handling, Esc and a backdrop from
         the browser. From 62rem, and without JavaScript, CSS shows it in the
         page instead. #}
      <dialog class="pf-index__filters" data-pf-index-filters aria-labelledby="pf-index-filters-title">
        <form id="pf-index-filter-form" method="get" action="{{ action }}" data-pf-index-form>
          <input type="hidden" name="q" value="{{ query }}">
          {% if mode != 'all' %}<input type="hidden" name="mode" value="{{ mode }}">{% endif %}
          <div class="pf-index__filters-head">
            <h2 class="pf-index__filters-title" id="pf-index-filters-title">{{ 'Filters'|t }}</h2>
            <button class="pf-index__filters-close" type="button" data-pf-index-close>{{ 'Close'|t }}</button>
          </div>
          {% for group in filters %}
            <fieldset class="pf-index__group">
              <legend class="pf-index__group-title">
                <span>{{ group.title }}</span>
                {% if group.about %}<button class="pf-index__about-open" type="button" aria-expanded="false" aria-controls="pf-index-about" data-pf-index-about><span class="pf-index__link-icon" aria-hidden="true">{{ source('libraries/fontawesome-pro/svgs/duotone/info-circle.svg', ignore_missing = true)|raw }}</span><span class="pf-index__link-text">{{ 'What are these?'|t }}</span></button>{% endif %}
              </legend>
              {# What each source searches, opened in the filter itself above its
                 options (index-search.js), so it never covers them. #}
              {% if group.about %}
                <div class="pf-index__about" id="pf-index-about" hidden>
                  <dl>
                    {% for entry in group.about %}
                      <dt>{{ entry.label }}</dt>
                      <dd>{{ entry.text }}</dd>
                    {% endfor %}
                  </dl>
                </div>
              {% endif %}
              {% if group.years is defined %}
                <div class="pf-index__years">
                  <div>
                    <label for="pf-index-from">{{ 'From'|t }}</label>
                    <input type="text" id="pf-index-from" name="from" value="{{ group.years.from }}" inputmode="numeric" pattern="[12][0-9]{3}" maxlength="4" autocomplete="off" title="{{ 'A four-digit year'|t }}" data-pf-index-year>
                  </div>
                  <div>
                    <label for="pf-index-to">{{ 'To'|t }}</label>
                    <input type="text" id="pf-index-to" name="to" value="{{ group.years.to }}" inputmode="numeric" pattern="[12][0-9]{3}" maxlength="4" autocomplete="off" title="{{ 'A four-digit year'|t }}" data-pf-index-year>
                  </div>
                </div>
              {% endif %}
              {# Checked while no source is: every one is searched. Not a
                 filter itself: index-search.js clears the sources when it's
                 chosen, and the address leaves it out. #}
              {% if group.all is defined %}
                <label class="pf-index__option pf-index__option--all">
                  <input type="checkbox" name="all" value="1"{% if group.all.checked %} checked{% endif %} data-pf-index-all>
                  <span class="pf-index__option-label">{{ group.all.label }}</span>
                </label>
              {% endif %}
              {% for option in group.options %}
                <label class="pf-index__option">
                  <input type="{{ group.single ? 'radio' : 'checkbox' }}" name="{{ group.name }}" value="{{ option.value }}"{% if option.checked %} checked{% endif %}{% if option.disabled %} disabled{% endif %}>
                  <span class="pf-index__option-label">{{ option.label }}</span>
                  {% if option.count is not null %}<span class="pf-index__count">{{ option.count|number_format }}</span>{% endif %}
                </label>
                {# A narrower choice of this source, set in under it. Its name says
                   which source it narrows, for anyone not seeing the indent. #}
                {% for sub in option.sub.options ?? [] %}
                  <label class="pf-index__option pf-index__option--sub">
                    <input type="checkbox" name="{{ option.sub.name }}" value="{{ sub.value }}"{% if sub.checked %} checked{% endif %}{% if sub.disabled %} disabled{% endif %}>
                    <span class="pf-index__option-label">{{ sub.label }}<span class="visually-hidden"> {{ '(in @source)'|t({'@source': option.label}) }}</span></span>
                    {% if sub.count is not null %}<span class="pf-index__count">{{ sub.count|number_format }}</span>{% endif %}
                  </label>
                {% endfor %}
                {# One series of the choice above (Oral histories), from a list
                   that keeps long names whole. Choosing one searches at once. #}
                {% if option.sub.series %}
                  {% set series_id = 'pf-index-series-' ~ option.value|clean_class %}
                  <div class="pf-index__option--sub pf-index__series">
                    <label for="{{ series_id }}">{{ 'Series'|t }}<span class="visually-hidden"> {{ '(oral histories)'|t }}</span></label>
                    <select id="{{ series_id }}" name="{{ option.sub.series.name }}">
                      <option value="">{{ 'All series'|t }}</option>
                      {% for entry in option.sub.series.options %}
                        <option value="{{ entry.value }}"{% if entry.selected %} selected{% endif %}{% if entry.disabled %} disabled{% endif %}>{{ entry.label }} ({{ entry.count|number_format }})</option>
                      {% endfor %}
                    </select>
                  </div>
                {% endif %}
              {% endfor %}
            </fieldset>
          {% endfor %}
          <button class="pf-index__apply" type="submit" data-pf-index-apply>{{ 'Show results'|t }}</button>
        </form>
      </dialog>

      <div class="pf-index__results">
        {% if query %}
          <div class="pf-index__toolbar">
            <p class="pf-index__total" data-pf-index-count>
              {%- if total is null or list_title -%}
                {{ 'Results for'|t }}
              {%- elseif capped -%}
                {{ '@total+ results for'|t({'@total': total|number_format}) }}
              {%- elseif total == 1 -%}
                {{ '1 result for'|t }}
              {%- else -%}
                {{ '@total results for'|t({'@total': total|number_format}) }}
              {%- endif %} <span class="pf-index__term">“{{ query }}”</span></p>
            {% if chips %}
              <div class="pf-index__chips" data-no-swup>
                <span class="visually-hidden" id="pf-index-chips">{{ 'Filters chosen'|t }}</span>
                <ul role="list" aria-labelledby="pf-index-chips">
                  {% for chip in chips %}
                    <li><a class="pf-index__chip" href="{{ chip.url }}"><span class="visually-hidden">{{ 'Remove filter:'|t }} </span>{{ chip.label }}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="m7 7 10 10M17 7 7 17"/></svg></a></li>
                  {% endfor %}
                </ul>
                <a class="pf-index__clear" href="{{ clear_url }}">{{ 'Clear all'|t }}</a>
              </div>
            {% endif %}
            {% if sorts and not list_title %}{{ index.sort(sorts, sort) }}{% endif %}
          </div>
        {% endif %}

        {# A short answer first, for a search about a service. Today's hours
           are filled in by the theme's index-search.js, as the Hours drawer's
           are; without it, the link to the full hours. #}
        {% if answer %}
          <section class="pf-index-answer" data-pf-index-answer="{{ answer.key }}" aria-labelledby="pf-index-answer-title">
            <div class="pf-index-answer__head">
              <h2 class="pf-index-answer__title" id="pf-index-answer-title">{{ answer.title }}</h2>
              <p class="pf-index-answer__date" data-pf-index-answer-date></p>
            </div>
            {% if answer.locations %}
              <ul class="pf-hours__list pf-index-answer__hours" role="list" hidden>
                {% for location in answer.locations %}
                  <li class="pf-hours__loc is-loading" data-pf-hours-loc data-lid="{{ location.lid }}">
                    <span class="pf-hours__badge" data-pf-hours-badge></span>
                    <span class="pf-hours__text">
                      <span class="pf-hours__when" data-pf-hours-when>{{ 'Loading hours…'|t }}</span>
                      <span class="pf-hours__name" data-pf-hours-name{% if location.name %} data-fixed{% endif %}>{{ location.name }}</span>
                    </span>
                  </li>
                {% endfor %}
              </ul>
            {% endif %}
            {% if answer.links %}
              <p class="pf-index-answer__links">
                {% for link in answer.links %}
                  <a href="{{ link.url }}">{{ link.label }}{% if link.external %}<svg class="pf-index-row__out" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M7 17 17 7M9 7h8v8"/></svg><span class="visually-hidden"> {{ '(another site)'|t }}</span>{% endif %}</a>
                {% endfor %}
              </p>
            {% endif %}
          </section>
        {% endif %}

        {% for section in sections %}
          <section class="pf-index-section pf-index-section--{{ section.key|clean_class }}" data-pf-index-source="{{ section.key }}" aria-labelledby="pf-index-{{ section.key }}">
            {# A heading as plain as the page's own: the source, how many it found
               (filled in when a late section arrives) and what it holds. #}
            <header class="pf-index-section__head">
              <h2 class="pf-index-section__title" id="pf-index-{{ section.key }}">{{ section.label }}</h2>
              <p class="pf-index-section__count" data-pf-index-section-count>{{ section.count }}</p>
              {% if section.about %}<p class="pf-index-section__about">{{ section.about }}</p>{% endif %}
              {% if section.via %}{{ index.via(section.via) }}{% endif %}
            </header>
            {% if section.late_url %}
              <div class="pf-index-section__late" data-pf-index-late="{{ section.late_url }}" aria-busy="true">
                <p class="pf-index-list__status"><a href="{{ section.full_url }}" data-no-swup>{{ 'Show results from @label'|t({'@label': section.label}) }}</a></p>
              </div>
            {% else %}
              {{ section.list }}
            {% endif %}
          </section>
        {% endfor %}

        {% if list %}
          <section{{ list_title ? ' class="pf-index-section"'|raw }}{% if list_source %} data-pf-index-source="{{ list_source }}"{% endif %} aria-labelledby="pf-index-results">
            {% if list_title %}
              <header class="pf-index-section__head pf-index__list-head">
                <h2 class="pf-index-section__title" id="pf-index-results">{{ list_title }}</h2>
                <p class="pf-index-section__count" data-pf-index-section-count>{% if total is not null %}{{ total == 1 ? '1 result'|t : '@total results'|t({'@total': total|number_format}) }}{% endif %}</p>
                {% if sorts %}{{ index.sort(sorts, sort) }}{% endif %}
              </header>
            {% else %}
              <h2 class="visually-hidden" id="pf-index-results">{{ 'Results'|t }}</h2>
            {% endif %}
            {% if via %}{{ index.via(via) }}{% endif %}{{ list }}
          </section>
        {% endif %}

        {% if sections is empty and not list %}
          <p class="pf-index-list__status">{{ 'No results.'|t }}</p>
        {% endif %}

        {% if links %}
          <aside class="pf-index__elsewhere" aria-label="{{ 'Search elsewhere'|t }}">
            <div class="pf-index-rule"><h2 class="pf-index-section__title">{{ 'Search elsewhere'|t }}</h2></div>
            <ul role="list">
              {% for link in links %}
                <li><a href="{{ link.url }}">{{ link.label }}<svg class="pf-index-row__out" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M7 17 17 7M9 7h8v8"/></svg><span class="visually-hidden"> {{ '(another site)'|t }}</span></a></li>
              {% endfor %}
            </ul>
          </aside>
        {% endif %}
      </div>
    </div>
  {% endif %}
  </div>

  {# Outside the swapped part, so it stays through a search. Decorative: the
     announcement says the same. js/index-search.js also copies the mark into a
     late section while it loads. pathLength="1" lets the CSS trace each letter
     without measuring it, as the site's own loading mark does. #}
  <div class="pf-index__loading" data-pf-index-loading aria-hidden="true">
