{#
/**
 * @file
 * The Index: the search page at /v2/search.
 *
 * Styles and script: palefire/index-search in the theme. Without JavaScript
 * the filters sit in the page with an Apply button, and a late section offers
 * a link to the source's own list. With it, filters apply as they're chosen
 * from 62rem, and open in a drawer on smaller screens.
 *
 * Variables:
 * - query, mode: the current search.
 * - action: the forms' address.
 * - modes: [label, url, current], the tabs.
 * - filters: [title, name, single, about, options: [label, value, count, checked]].
 *   single: one choice, as round buttons. about: [label, text], what each source
 *   is, opened from the group's title. count is
 *   NULL for a source that's only counted by searching it. A group with years
 *   instead of options is a year range: [from, to].
 * - chips: [label, url], the chosen filters as links that remove them.
 * - clear_url: the search with no filters.
 * - selected_count: how many filters are chosen.
 * - total: the list's total, when there's one list.
 * - capped: there may be more than the total, which is as far as a service reads.
 * - sort, sorts: the current sort and those on offer (value => label).
 * - links: [label, url], searches elsewhere.
 * - via: the service behind a chosen source: [label, url, also: [label, url]].
 *   A section can have its own.
 * - sections: [key, label, list or late_url and full_url].
 * - list: one list, when a source is chosen or the mode is merged.
 * - list_title: the list's visible name, when sections lead above it. It then
 *   carries its own total and sort, which don't speak for those sections.
 * - list_source: the source whose place in a visitor's order the list takes.
 * - notice: a message about this search.
 */
#}
{% import _self as index %}
{% macro sort(sorts, current) %}
  <div class="pf-index__sort">
    <label for="pf-index-sort">{{ 'Sort by'|t }}</label>
    <select id="pf-index-sort" name="sort" form="pf-index-filter-form">
      {% for value, label in sorts %}
        <option value="{{ value }}"{% if value == current %} selected{% endif %}>{{ label }}</option>
      {% endfor %}
    </select>
  </div>
{% endmacro %}
{% macro via(via) %}
  <p class="pf-index-via">{{ 'Go to'|t }} <a href="{{ via.url }}">{{ via.label }}<svg class="pf-index-row__out" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M7 17 17 7M9 7h8v8"/></svg><span class="visually-hidden"> {{ '(another site)'|t }}</span></a>{% for other in via.also %}<span aria-hidden="true"> · </span>{{ 'Also try the'|t }} <a href="{{ other.url }}">{{ other.label }}<svg class="pf-index-row__out" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M7 17 17 7M9 7h8v8"/></svg><span class="visually-hidden"> {{ '(another site)'|t }}</span></a>{% endfor %}</p>
{% endmacro %}
{# data-no-swup on whatever changes the search: js/index-search.js swaps the
   results for those, and Swup would prefetch them on hover, running a whole
   search each time. Result links stay Swup's. #}
<div class="pf-index" data-pf-index>
  <header class="pf-index__head">
    <p class="pf-index__kicker">{{ 'LSU Libraries'|t }}<span class="visually-hidden">, </span><span class="pf-index__kicker-place">{{ 'Search'|t }}</span></p>
    <h1 class="pf-index__title">{{ 'Index'|t }}</h1>
    <p class="pf-index__lede">{{ 'Search articles, databases, archives and library pages.'|t }}</p>
    <form class="pf-index__form" role="search" method="get" action="{{ action }}">
      <label class="visually-hidden" for="pf-index-q">{{ 'Search LSU Libraries'|t }}</label>
      <div class="pf-index__field">
        <input class="pf-index__input" type="search" id="pf-index-q" name="q" value="{{ query }}" maxlength="128" autocomplete="off" enterkeyhint="search">
        {% if mode != 'all' %}<input type="hidden" name="mode" value="{{ mode }}">{% endif %}
        <button class="pf-index__submit" type="submit">{{ 'Search'|t }}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true" focusable="false"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m15.5 15.5 5 5"/></svg></button>
      </div>
    </form>
    <nav class="pf-index__modes" aria-label="{{ 'What to search'|t }}" data-no-swup>
      <ul role="list">
        {% for link in modes %}
          <li><a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.label }}</a></li>
        {% endfor %}
      </ul>
    </nav>
  </header>

  <div class="pf-index__main" data-pf-index-main tabindex="-1">
  {% if not query %}
    <p class="pf-index__prompt">{{ 'Enter a word or two to begin.'|t }}</p>
  {% else %}
    {% if notice %}
      <p class="pf-index__notice" role="status">{{ notice }}</p>
    {% endif %}

    <div class="pf-index__body" data-pf-index-body>
      <button class="pf-index__filters-open" type="button" data-pf-index-open aria-haspopup="dialog">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M4 7h16M7 12h10M10 17h4"/></svg>
        {{ 'Filters'|t }}{% if selected_count %} ({{ selected_count }}){% endif %}
      </button>

      {# A <dialog> so the drawer gets focus handling, Esc and a backdrop from
         the browser. From 62rem, and without JavaScript, CSS shows it in the
         page instead. #}
      <dialog class="pf-index__filters" data-pf-index-filters aria-labelledby="pf-index-filters-title">
        <form id="pf-index-filter-form" method="get" action="{{ action }}" data-pf-index-form>
          <input type="hidden" name="q" value="{{ query }}">
          {% if mode != 'all' %}<input type="hidden" name="mode" value="{{ mode }}">{% endif %}
          <div class="pf-index__filters-head">
            <h2 class="pf-index__filters-title" id="pf-index-filters-title">{{ 'Filters'|t }}</h2>
            <button class="pf-index__filters-close" type="button" data-pf-index-close>{{ 'Close'|t }}</button>
          </div>
          {% for group in filters %}
            <fieldset class="pf-index__group">
              <legend class="pf-index__group-title">
                <span>{{ group.title }}</span>
                {% if group.about %}<button class="pf-index__about-open" type="button" popovertarget="pf-index-about" style="anchor-name:--pf-index-about">{{ 'What are these?'|t }}</button>{% endif %}
              </legend>
              {% if group.about %}
                <div class="pf-term__card pf-index__about" id="pf-index-about" popover style="position-anchor:--pf-index-about">
                  <p class="pf-term__name">{{ 'What each source searches'|t }}</p>
                  <dl>
                    {% for entry in group.about %}
                      <dt>{{ entry.label }}</dt>
                      <dd>{{ entry.text }}</dd>
                    {% endfor %}
                  </dl>
                </div>
              {% endif %}
              {% if group.years is defined %}
                <div class="pf-index__years">
                  <div>
                    <label for="pf-index-from">{{ 'From'|t }}</label>
                    <input type="text" id="pf-index-from" name="from" value="{{ group.years.from }}" inputmode="numeric" pattern="[12][0-9]{3}" maxlength="4" autocomplete="off" title="{{ 'A four-digit year'|t }}" data-pf-index-year>
                  </div>
                  <div>
                    <label for="pf-index-to">{{ 'To'|t }}</label>
                    <input type="text" id="pf-index-to" name="to" value="{{ group.years.to }}" inputmode="numeric" pattern="[12][0-9]{3}" maxlength="4" autocomplete="off" title="{{ 'A four-digit year'|t }}" data-pf-index-year>
                  </div>
                </div>
              {% endif %}
              {% for option in group.options %}
                <label class="pf-index__option">
                  <input type="{{ group.single ? 'radio' : 'checkbox' }}" name="{{ group.name }}" value="{{ option.value }}"{% if option.checked %} checked{% endif %}{% if option.disabled %} disabled{% endif %}>
                  <span class="pf-index__option-label">{{ option.label }}</span>
                  {% if option.count is not null %}<span class="pf-index__count">{{ option.count|number_format }}</span>{% endif %}
                </label>
              {% endfor %}
            </fieldset>
          {% endfor %}
          <button class="pf-index__apply" type="submit" data-pf-index-apply>{{ 'Show results'|t }}</button>
        </form>
      </dialog>

      <div class="pf-index__results">
        {% if query %}
          <div class="pf-index__toolbar">
            <p class="pf-index__total" data-pf-index-count>
              {%- if total is null or list_title -%}
                {{ 'Results for'|t }}
              {%- elseif capped -%}
                {{ '@total+ results for'|t({'@total': total|number_format}) }}
              {%- elseif total == 1 -%}
                {{ '1 result for'|t }}
              {%- else -%}
                {{ '@total results for'|t({'@total': total|number_format}) }}
              {%- endif %} <span class="pf-index__term">“{{ query }}”</span></p>
            {% if sorts and not list_title %}{{ index.sort(sorts, sort) }}{% endif %}
          </div>
          {% if chips %}
            <div class="pf-index__chips" data-no-swup>
              <span class="visually-hidden" id="pf-index-chips">{{ 'Filters chosen'|t }}</span>
              <ul role="list" aria-labelledby="pf-index-chips">
                {% for chip in chips %}
                  <li><a class="pf-index__chip" href="{{ chip.url }}"><span class="visually-hidden">{{ 'Remove filter:'|t }} </span>{{ chip.label }}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="m7 7 10 10M17 7 7 17"/></svg></a></li>
                {% endfor %}
              </ul>
              <a class="pf-index__clear" href="{{ clear_url }}">{{ 'Clear all'|t }}</a>
            </div>
          {% endif %}
        {% endif %}

        {% for section in sections %}
          <section class="pf-index-section pf-index-section--{{ section.key|clean_class }}" data-pf-index-source="{{ section.key }}" aria-labelledby="pf-index-{{ section.key }}">
            <div class="pf-index-rule"><h2 class="pf-index-section__title" id="pf-index-{{ section.key }}">{% if section.about %}<button class="pf-term" type="button" popovertarget="pf-index-about-{{ section.key }}" style="anchor-name:--pf-index-about-{{ section.key }}">{{ section.label }}</button>{% else %}{{ section.label }}{% endif %}</h2>{% if section.about %}<div class="pf-term__card" id="pf-index-about-{{ section.key }}" popover style="position-anchor:--pf-index-about-{{ section.key }}"><p class="pf-term__name">{{ section.label }}</p><p class="pf-term__definition">{{ section.about }}</p></div>{% endif %}{% if section.via %}{{ index.via(section.via) }}{% endif %}</div>
            {% if section.late_url %}
              <div class="pf-index-section__late" data-pf-index-late="{{ section.late_url }}" aria-busy="true">
                <p class="pf-index-list__status"><a href="{{ section.full_url }}" data-no-swup>{{ 'Show results from @label'|t({'@label': section.label}) }}</a></p>
              </div>
            {% else %}
              {{ section.list }}
            {% endif %}
          </section>
        {% endfor %}

        {% if list %}
          <section{{ list_title ? ' class="pf-index-section"'|raw }}{% if list_source %} data-pf-index-source="{{ list_source }}"{% endif %} aria-labelledby="pf-index-results">
            {% if list_title %}
              <div class="pf-index-rule pf-index__list-head">
                <h2 class="pf-index-section__title" id="pf-index-results">{{ list_title }}</h2>
                {% if total is not null %}<p class="pf-index__total">{{ total == 1 ? '1 result'|t : '@total results'|t({'@total': total|number_format}) }}</p>{% endif %}
                {% if sorts %}{{ index.sort(sorts, sort) }}{% endif %}
              </div>
            {% else %}
              <h2 class="visually-hidden" id="pf-index-results">{{ 'Results'|t }}</h2>
            {% endif %}
            {% if via %}{{ index.via(via) }}{% endif %}{{ list }}
          </section>
        {% endif %}

        {% if sections is empty and not list %}
          <p class="pf-index-list__status">{{ 'No results.'|t }}</p>
        {% endif %}

        {% if links %}
          <aside class="pf-index__elsewhere" aria-label="{{ 'Search elsewhere'|t }}">
            <div class="pf-index-rule"><h2 class="pf-index-section__title">{{ 'Search elsewhere'|t }}</h2></div>
            <ul role="list">
              {% for link in links %}
                <li><a href="{{ link.url }}">{{ link.label }}<svg class="pf-index-row__out" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M7 17 17 7M9 7h8v8"/></svg><span class="visually-hidden"> {{ '(another site)'|t }}</span></a></li>
              {% endfor %}
            </ul>
          </aside>
        {% endif %}
      </div>
    </div>
  {% endif %}
  </div>

  {# Outside the swapped part, so it stays through a search. Decorative: the
     announcement says the same. js/index-search.js also copies the mark into a
     late section while it loads. pathLength="1" lets the CSS trace each letter
     without measuring it, as the site's own loading mark does. #}
  <div class="pf-index__loading" data-pf-index-loading aria-hidden="true">
    <div class="pf-index__mark">
      <svg viewBox="-1 -1 526 165" width="524" height="163" focusable="false"><polygon pathLength="1" points="56,129.8 146.2,129.8 146.2,162.7 0,162.7 0,0 56,0"/><path pathLength="1" d="M208.3,0h125.9v33.2h-99.3c-10.4,0-18.9,6.3-18.9,14v17.5h118.2v61.8c0,19.9-21.9,36.2-48.9,36.2H159.6v-33.2h99.1c10.6,0,19.1-6.3,19.1-14V97.8H159.6V36.2C159.6,16.3,181.5,0,208.3,0"/><path pathLength="1" d="M466.9,0h56.2v126.5c0,19.9-21.9,36.2-48.7,36.2H349V0.4h55.8v129.4h43c10.6,0,19.1-6.3,19.1-14.2V0z"/></svg>
      <span class="pf-index__mark-label">{{ 'Searching'|t }}</span>
    </div>
  </div>
</div>
