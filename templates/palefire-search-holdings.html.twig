{#
/**
 * @file
 * Where listed records are held: a fragment the list's rows take their parts
 * from once it loads.
 *
 * Variables:
 * - records: each [id, state, place, reason, due, more, url, copies].
 *   state: available, online, out or listed. Each copy is one library and shelf:
 *   [library, shelf, type, call_number, general_call, call_more, floor, map_url,
 *   has (lines), available,
 *   total, online, reason, due, hold_url, request_url, reading_room, items,
 *   items_more]. Each
 *   item, on a shelf with more than one: [call_number, contents, available,
 *   reason, due, request_url].
 */
#}
{% macro why(entry) %}{{ entry.reason ?: 'Ask at the library'|t }}{% if entry.due %}, {{ 'due @date'|t({'@date': entry.due}) }}{% endif %}{% endmacro %}
{% macro out(url, label, about) %}<a class="pf-button--secondary" href="{{ url }}">{{ label }}{% if about %}<span class="visually-hidden">: {{ about }}</span>{% endif %}<span class="visually-hidden"> {{ '(another site)'|t }}</span><svg class="pf-index-row__out" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M7 17 17 7M9 7h8v8"/></svg></a>{% endmacro %}
{% import _self as holdings %}
{% for record in records %}
  {# One shelf of numbered items: the list's row names the first item's call
     number, and index-search.js swaps in the one for them all, or says there
     are more. #}
  {% set only = record.copies|length == 1 ? record.copies|first %}
  {% set first_call = only and only.items ? (only.items|first).call_number %}
  {% set whole_call = first_call ? (only.general_call ?: (only.call_count > 1 ? '@call + @count more'|t({'@call': first_call, '@count': only.call_count - 1}))) %}
  <div data-pf-index-holdings-for="{{ record.id }}"{% if whole_call %} data-pf-index-call="{{ whole_call }}" data-pf-index-call-first="{{ first_call }}"{% endif %}>
    {% if record.state == 'online' and record.more == 0 %}
      <p class="pf-index-row__holdings-line"><span class="pf-index-row__status">{{ 'Available online'|t }}</span></p>
    {% else %}
      <details class="pf-index-row__details">
        <summary>
          <span class="pf-index-row__toggle">
          <span class="pf-index-row__where">
            {%- if record.state == 'available' -%}
              <span class="pf-index-row__status">{{ 'Available'|t }}</span> {{ 'at @place'|t({'@place': record.place}) }}
            {%- elseif record.state == 'online' -%}
              <span class="pf-index-row__status">{{ 'Available online'|t }}</span>
            {%- elseif record.state == 'out' -%}
              <span class="pf-index-row__status">{{ 'Not available'|t }}</span> · {{ holdings.why(record) }}
            {%- else -%}
              <span class="pf-index-row__status">{{ 'Held'|t }}</span> {{ 'at @place'|t({'@place': record.place}) }}
            {%- endif -%}
            {%- if record.more > 0 %} · {{ '+ @count more'|t({'@count': record.more}) }}{% endif -%}
          </span>
          <span class="pf-button--secondary"><span class="pf-index-row__toggle-label"><span class="pf-index-row__when-closed">{{ record.copies|length > 1 ? 'Show @count locations'|t({'@count': record.copies|length}) : (only.items ? 'Show @count items'|t({'@count': only.total}) : 'Show location'|t) }}</span><span class="pf-index-row__when-open">{{ record.copies|length > 1 ? 'Hide @count locations'|t({'@count': record.copies|length}) : (only.items ? 'Hide @count items'|t({'@count': only.total}) : 'Hide location'|t) }}</span></span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M12 5v14M5 12h14"/></svg></span>
          </span>
        </summary>
        <div class="pf-index-row__copies-table">
          <table role="table">
            <caption class="visually-hidden">{{ 'Where this is held'|t }}</caption>
            <thead role="rowgroup">
              <tr role="row">
                <th role="columnheader" scope="col">{{ 'Library'|t }}</th>
                <th role="columnheader" scope="col">{{ 'Shelf location'|t }}</th>
                <th role="columnheader" scope="col">{{ 'Material type'|t }}</th>
                <th role="columnheader" scope="col">{{ 'Call number'|t }}</th>
                <th role="columnheader" scope="col">{{ 'Status'|t }}</th>
                <th role="columnheader" scope="col"><span class="visually-hidden">{{ 'Actions'|t }}</span></th>
              </tr>
            </thead>
            <tbody role="rowgroup">
              {# The reading room note goes under the first shelf it's about. #}
              {% set note_at = record.copies|filter(c => c.reading_room)|keys|first %}
              {% for copy in record.copies %}
                <tr role="row">
                  <td role="cell" data-label="{{ 'Library'|t }}">{{ copy.library }}</td>
                  <td role="cell" data-label="{{ 'Shelf location'|t }}">{{ copy.shelf }}{% if copy.floor %}<span class="pf-index-row__floor">{{ copy.floor }}</span>{% endif %}</td>
                  <td role="cell" data-label="{{ 'Material type'|t }}">{{ copy.type }}</td>
                  <td role="cell" data-label="{{ 'Call number'|t }}">{{ copy.call_number }}{% if copy.call_more %} {{ '+ @count more'|t({'@count': copy.call_more}) }}{% endif %}</td>
                  <td role="cell" data-label="{{ 'Status'|t }}">
                    {%- if not copy.total -%}
                      {{ 'Ask at the library'|t }}
                    {%- elseif copy.total == 1 and copy.available == 1 -%}
                      {{ copy.online ? 'Available online'|t : (copy.reading_room ? 'Available to view'|t : 'Available'|t) }}
                    {%- elseif copy.available -%}
                      {{ '@available of @total available'|t({'@available': copy.available, '@total': copy.total}) }}
                    {%- else -%}
                      {{ holdings.why(copy) }}
                    {%- endif -%}
                  </td>
                  <td role="cell" class="pf-index-row__copy-actions">
                    {%- if copy.map_url %}{{ holdings.out(copy.map_url, 'Find in the Library'|t) }}{% endif -%}
                    {%- if copy.hold_url %}{{ holdings.out(copy.hold_url, 'Place hold'|t) }}{% endif -%}
                    {%- if copy.request_url %}{{ holdings.out(copy.request_url, 'Request to view'|t) }}{% endif -%}
                  </td>
                </tr>
                {# A serial's run can be very long: its own row, across the table. The
                   catalog writes it with no space after a comma, so it can't wrap. #}
                {% if copy.has %}
                  <tr role="row" class="pf-index-row__copy-has">
                    <td role="cell" colspan="6" data-label="{{ 'LSU has'|t }}">
                      {%- for line in copy.has -%}
                        <span>{{ line|replace({',': ', ', ', ': ', '}) }}</span>
                      {%- endfor -%}
                    </td>
                  </tr>
                {% endif %}
                {% if note_at is not same as(false) and note_at is not null and loop.index0 == note_at %}
                  <tr role="row" class="pf-index-row__copy-note-row">
                    <td role="cell" colspan="6">
                      <p class="pf-index-row__copy-note"><svg class="pf-index-row__info" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 8h.01"/></svg><span>{{ 'Viewed in the Hill Memorial reading room.'|t }} <a href="/v2/special/guides/special-collections" target="_blank" data-no-swup>{{ 'How requests work'|t }}<span class="visually-hidden"> {{ '(opens in a new tab)'|t }}</span><svg class="pf-index-row__out" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M7 17 17 7M9 7h8v8"/></svg></a></span></p>
                    </td>
                  </tr>
                {% endif %}
                {# Each box or volume, in the columns above, with its own request. Where
                   it has no contents, its shelf is said again, muted, so the row is
                   whole; a stacked row leaves that out (index-search.scss). #}
                {% for item in copy.items %}
                  <tr role="row" class="pf-index-row__copy-item">
                    {% if item.contents %}
                      <td role="cell" class="pf-index-row__item-contents" colspan="3" data-label="{{ 'LSU has'|t }}">
                        {%- for line in item.contents -%}
                          <span>{{ line|replace({',': ', ', ', ': ', '}) }}</span>
                        {%- endfor -%}
                      </td>
                    {% else %}
                      <td role="cell" class="pf-index-row__item-same" data-label="{{ 'Library'|t }}">{{ copy.library }}</td>
                      <td role="cell" class="pf-index-row__item-same" data-label="{{ 'Shelf location'|t }}">{{ copy.shelf }}</td>
                      <td role="cell" class="pf-index-row__item-same" data-label="{{ 'Material type'|t }}">{{ copy.type }}</td>
                    {% endif %}
                    <td role="cell" class="pf-index-row__item-call" data-label="{{ 'Call number'|t }}">{{ item.call_number }}</td>
                    <td role="cell" data-label="{{ 'Status'|t }}">{{ item.available ? (copy.reading_room ? 'Available to view'|t : 'Available'|t) : holdings.why(item) }}</td>
                    <td role="cell" class="pf-index-row__copy-actions">
                      {%- if item.request_url %}{{ holdings.out(item.request_url, 'Request to view'|t, item.call_number) }}{% endif -%}
                    </td>
                  </tr>
                {% endfor %}
                {% if copy.items_more %}
                  <tr role="row" class="pf-index-row__copy-more">
                    <td role="cell" colspan="6">{{ '+ @count more in the full record'|t({'@count': copy.items_more}) }}</td>
                  </tr>
                {% endif %}
              {% endfor %}
            </tbody>
          </table>
          <p class="pf-index-row__full" data-no-swup><a href="{{ record.url }}">{{ 'Full record in the catalog'|t }}<span class="visually-hidden"> {{ '(another site)'|t }}</span><svg class="pf-index-row__out" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M7 17 17 7M9 7h8v8"/></svg></a></p>
        </div>
      </details>
    {% endif %}
  </div>
{% endfor %}
