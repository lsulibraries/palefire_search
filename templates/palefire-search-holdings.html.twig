{#
/**
 * @file
 * Where listed records are held: a fragment the list's rows take their parts
 * from once it loads.
 *
 * Variables:
 * - records: each [id, key, state, place, reason, due, more, url, copies]. key
 *   names the row it fills when that is not the record itself (a finding aid).
 *   state: available, online, out or listed. Each copy is one library and shelf:
 *   [library, library_name, library_more, item_id, shelf, type, stack_location, call_number, general_call, call_more, floor, map_url,
 *   has (lines), available,
 *   total, online, reason, due, hold_url, request_url, reading_room, items,
 *   items_more]. Each
 *   item, on a shelf with more than one: [item_id, call_number, contents, available,
 *   reason, due, request_url].
 */
#}
{% macro why(entry) %}{{ entry.reason ?: 'Ask at the library'|t }}{% if entry.due %}, {{ 'due @date'|t({'@date': entry.due}) }}{% endif %}{% endmacro %}
{% macro out(url, label, about) %}<a class="pf-button--secondary" href="{{ url }}">{{ label }}{% if about %}<span class="visually-hidden">: {{ about }}</span>{% endif %}<span class="visually-hidden"> {{ '(another site)'|t }}</span><svg class="pf-index-row__out" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M7 17 17 7M9 7h8v8"/></svg></a>{% endmacro %}
{% import _self as holdings %}
{% for record in records %}
  {# One shelf of numbered items: the list's row names the first item's call
     number, and index-search.js swaps in the one for them all, or says there
     are more. #}
  {% set only = record.copies|length == 1 ? record.copies|first %}
  {% set first_call = only and only.items ? (only.items|first).call_number %}
  {% set whole_call = first_call ? (only.general_call ?: (only.call_count > 1 ? '@call + @count more'|t({'@call': first_call, '@count': only.call_count - 1}))) %}
  <div data-pf-index-holdings-for="{{ record.key ?: record.id }}"{% if whole_call %} data-pf-index-call="{{ whole_call }}" data-pf-index-call-first="{{ first_call }}"{% endif %}>
    {% if record.state == 'online' and record.more == 0 %}
      <p class="pf-index-row__holdings-line pf-index-row__holdings-line--online"><span class="pf-index-row__status">{{ 'Available online'|t }}</span></p>
    {% else %}
      <details class="pf-index-row__details" data-pf-index-copies="{{ path('palefire_search.copies', {}, {'query': {'id': record.id}}) }}">
        <summary>
          <span class="pf-index-row__toggle">
          <span class="pf-index-row__where">
            {%- if record.state == 'available' -%}
              <span class="pf-index-row__status">{{ 'Available'|t }}</span> {{ 'at @place'|t({'@place': record.place}) }}
            {%- elseif record.state == 'online' -%}
              <span class="pf-index-row__status">{{ 'Available online'|t }}</span>
            {%- elseif record.state == 'out' -%}
              <span class="pf-index-row__status">{{ 'Not available'|t }}</span> · {{ holdings.why(record) }}
            {%- else -%}
              <span class="pf-index-row__status">{{ 'Held'|t }}</span> {{ 'at @place'|t({'@place': record.place}) }}
            {%- endif -%}
            {%- if record.more > 0 %} · {{ '+ @count more'|t({'@count': record.more}) }}{% endif -%}
          </span>
          <span class="pf-button--secondary"><span class="pf-index-row__toggle-label"><span class="pf-index-row__when-closed">{{ record.copies|length > 1 ? 'Show @count locations'|t({'@count': record.copies|length}) : (only.items ? 'Show @count items'|t({'@count': only.total}) : 'Show location'|t) }}</span><span class="pf-index-row__when-open">{{ record.copies|length > 1 ? 'Hide @count locations'|t({'@count': record.copies|length}) : (only.items ? 'Hide @count items'|t({'@count': only.total}) : 'Hide location'|t) }}</span></span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M12 5v14M5 12h14"/></svg></span>
          </span>
        </summary>
        {# Each library is a group: what's the same for its copies is said once in
           its heading, with its own buttons, and its table keeps only what differs
           from copy to copy. Copy numbers arrive when the table opens, and a
           library's copies sort within it (index-search.js). #}
        {% set note_at = record.copies|filter(c => c.reading_room)|keys|first %}
        {% set copy_total = record.copies|reduce((sum, c) => sum + c.total, 0) %}
        <div class="pf-index-row__copies-table">
          {% for copy in record.copies %}
            {% set place_id = 'pf-index-place-' ~ (record.key ?: record.id) ~ '-' ~ loop.index %}
            {% set sortable = copy.items|length > 1 %}
            {# An archive's numbers say where its boxes stand on the shelves. #}
            {% set call_label = copy.stack_location ? 'Stack location'|t : 'Call number'|t %}
            <section class="pf-index-row__place" aria-labelledby="{{ place_id }}">
              <div class="pf-index-row__place-head">
                <div class="pf-index-row__place-about">
                  <h4 class="pf-index-row__place-name" id="{{ place_id }}">{{ copy.library_name }}</h4>
                  <p class="pf-index-row__place-detail">
                    {%- if copy.library_more %}{{ copy.library_more }} · {% endif -%}
                    {{ copy.shelf }}{% if copy.floor %}, {{ copy.floor }}{% endif %}
                    {%- if copy.type %} · {{ copy.type }}{% endif -%}
                  </p>
                </div>
                <div class="pf-index-row__copy-actions">
                  {%- if copy.map_url %}{{ holdings.out(copy.map_url, 'Find in the Library'|t) }}{% endif -%}
                  {%- if copy.hold_url %}{{ holdings.out(copy.hold_url, 'Place hold'|t) }}{% endif -%}
                  {%- if copy.request_url %}{{ holdings.out(copy.request_url, 'Request to view'|t) }}{% endif -%}
                </div>
              </div>
              {# Said once, under the first library it's about. #}
              {% if note_at is not same as(false) and note_at is not null and loop.index0 == note_at %}
                <p class="pf-index-row__copy-note"><svg class="pf-index-row__info" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 8h.01"/></svg><span>{{ 'Viewed in the Hill Memorial reading room, by request.'|t }} <a href="/v2/special/guides/special-collections" target="_blank" data-no-swup>{{ 'How requests work'|t }}<span class="visually-hidden"> {{ '(opens in a new tab)'|t }}</span><svg class="pf-index-row__out" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M7 17 17 7M9 7h8v8"/></svg></a></span></p>
              {% endif %}
              {# A serial's run that no single box claims. The catalog writes it with
                 no space after a comma, so it can't wrap until it has one. #}
              {% if copy.has %}
                <div class="pf-index-row__copy-has">
                  <p class="pf-index-row__copy-has-label">{{ 'LSU has'|t }}</p>
                  {%- for line in copy.has -%}
                    <p>{{ line|replace({',': ', ', ', ': ', '}) }}</p>
                  {%- endfor -%}
                </div>
              {% endif %}
              <table role="table">
                <caption class="visually-hidden">{{ 'Copies at @library'|t({'@library': copy.library}) }}</caption>
                <thead role="rowgroup">
                  <tr role="row">
                    {% if sortable %}<th role="columnheader" scope="col"><span class="pf-index-row__th-text">{{ call_label }}</span><button type="button" class="pf-index-row__sort" data-pf-index-sort="call">{{ call_label }}<svg class="pf-index-row__sort-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path class="pf-index-row__sort-up" d="M12 4 18 10H6Z"/><path class="pf-index-row__sort-down" d="M12 20 6 14H18Z"/></svg></button></th>{% else %}<th role="columnheader" scope="col">{{ call_label }}</th>{% endif %}
                    <th role="columnheader" scope="col">{{ 'Copy'|t }}</th>
                    {% if sortable %}<th role="columnheader" scope="col"><span class="pf-index-row__th-text">{{ 'Status'|t }}</span><button type="button" class="pf-index-row__sort" data-pf-index-sort="status">{{ 'Status'|t }}<svg class="pf-index-row__sort-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path class="pf-index-row__sort-up" d="M12 4 18 10H6Z"/><path class="pf-index-row__sort-down" d="M12 20 6 14H18Z"/></svg></button></th>{% else %}<th role="columnheader" scope="col">{{ 'Status'|t }}</th>{% endif %}
                    <th role="columnheader" scope="col"><span class="visually-hidden">{{ 'Actions'|t }}</span></th>
                  </tr>
                </thead>
                <tbody role="rowgroup">
                  {% if copy.items %}
                    {# Each box or volume, with what it holds and its own request. #}
                    {% for item in copy.items %}
                      <tr role="row" class="pf-index-row__copy-item" data-pf-index-available="{{ item.available ? 1 : 0 }}">
                        <td role="cell" class="pf-index-row__item-call" data-label="{{ call_label }}"><span class="pf-index-row__item-number">{{ item.call_number }}</span>
                          {%- if item.contents -%}
                            <span class="pf-index-row__item-contents"><span class="visually-hidden">{{ 'LSU has'|t }}: </span>
                              {%- for line in item.contents -%}
                                <span>{{ line|replace({',': ', ', ', ': ', '}) }}</span>
                              {%- endfor -%}
                            </span>
                          {%- endif -%}
                        </td>
                        <td role="cell" class="pf-index-row__item-copy" data-label="{{ 'Copy'|t }}"{% if item.item_id %} data-pf-index-copy-of="{{ item.item_id }}"{% endif %}></td>
                        <td role="cell" class="pf-index-row__item-status" data-label="{{ 'Status'|t }}">{{ item.available ? (copy.reading_room ? 'Available to view'|t : 'Available'|t) : holdings.why(item) }}</td>
                        <td role="cell" class="pf-index-row__copy-actions">
                          {%- if item.request_url %}{{ holdings.out(item.request_url, 'Request to view'|t, item.call_number) }}{% endif -%}
                        </td>
                      </tr>
                    {% endfor %}
                    {% if copy.items_more %}
                      <tr role="row" class="pf-index-row__copy-more">
                        <td role="cell" colspan="4">{{ '+ @count more in the full record'|t({'@count': copy.items_more}) }}</td>
                      </tr>
                    {% endif %}
                  {% else %}
                    {# One copy, or none to count: one row. Its buttons are in the heading. #}
                    <tr role="row" class="pf-index-row__copy-item">
                      <td role="cell" class="pf-index-row__item-call" data-label="{{ call_label }}"><span class="pf-index-row__item-number">{{ copy.call_number }}{% if copy.call_more %} {{ '+ @count more'|t({'@count': copy.call_more}) }}{% endif %}</span></td>
                      <td role="cell" class="pf-index-row__item-copy" data-label="{{ 'Copy'|t }}"{% if copy.item_id %} data-pf-index-copy-of="{{ copy.item_id }}"{% endif %}></td>
                      <td role="cell" class="pf-index-row__item-status" data-label="{{ 'Status'|t }}">
                        {%- if not copy.total -%}
                          {{ 'Ask at the library'|t }}
                        {%- elseif copy.available -%}
                          {{ copy.online ? 'Available online'|t : (copy.reading_room ? 'Available to view'|t : 'Available'|t) }}
                        {%- else -%}
                          {{ holdings.why(copy) }}
                        {%- endif -%}
                      </td>
                      <td role="cell" class="pf-index-row__copy-actions"></td>
                    </tr>
                  {% endif %}
                </tbody>
              </table>
            </section>
          {% endfor %}
          {# What the panel covered, and the way to everything it leaves out. #}
          <div class="pf-index-row__foot">
            <p class="pf-index-row__foot-count">
              {%- if copy_total > 0 -%}
                {{ copy_total == 1 ? '1 copy'|t : '@count copies'|t({'@count': copy_total}) }}
                {%- if record.copies|length > 1 %} {{ 'in @count libraries'|t({'@count': record.copies|length}) }}{% endif -%}
              {%- endif -%}
            </p>
            <a class="pf-index-row__full" href="{{ record.url }}" data-no-swup>{{ 'Full record in the catalog'|t }}<span class="visually-hidden"> {{ '(another site)'|t }}</span><svg class="pf-index-row__out" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M7 17 17 7M9 7h8v8"/></svg></a>
          </div>
        </div>
      </details>
    {% endif %}
  </div>
{% endfor %}
