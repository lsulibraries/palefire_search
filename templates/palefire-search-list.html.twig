{#
/**
 * @file
 * One list of results. Also the fragment a late section loads, so its count
 * and links live here.
 *
 * Variables:
 * - label: the source's name.
 * - total: how many results, or NULL when the source couldn't be reached.
 * - items: [title, url, external, summary, excerpt, pdf, meta, source, type, full_text_url,
 *   image, image_url, login, holdings_id]. pdf is [pages, size] for a PDF on this site;
 *   pages is empty when the file couldn't be read for them. holdings_id holds a place for where
 *   the record's copies are, which loads after the list. type says what the
 *   record is, such as Book. login
 *   is TRUE when the link asks for an LSU account off campus.
 *   title and summary are already escaped, with the searched words in <mark>.
 *   image is a local picture's render array. image_url is a cover from another
 *   host, sent no referrer so the search stays private. alt is empty on both:
 *   the title beside the picture already names the result. details lists an
 *   E-Textbook's copies, each [class, instructor, instructor_is_email, section,
 *   term].
 * - failed: the source couldn't be reached. Not the same as no results.
 * - simplified: what was searched instead, when the source can't use operators.
 * - backup: the source's usual search is down and a stand-in answered.
 * - holdings_url: where the holdings_id places load from.
 * - limited: how many can be paged to, on the last page when more were found.
 * - more_url, more_label: a link to go further.
 * - pager: a pager, or NULL.
 */
#}
<div class="pf-index-list" data-pf-index-total="{{ total }}">
  {% if simplified %}
    <p class="pf-index-list__status">{{ '@label can’t use AND, OR or NOT, so it searched for: @terms'|t({'@label': label, '@terms': simplified}) }}</p>
  {% endif %}
  {% if failed %}
    <p class="pf-index-list__status">{{ 'We couldn’t reach @label just now.'|t({'@label': label}) }}
      {% if more_url %}<a href="{{ more_url }}">{{ more_label }}</a>{% endif %}
    </p>
  {% elseif not items %}
    <p class="pf-index-list__status">{{ 'No results.'|t }}
      {% if more_url %}<a href="{{ more_url }}">{{ more_label }}</a>{% endif %}
    </p>
  {% else %}
    {% if backup %}
      <p class="pf-index-list__status">{{ 'The usual @label search isn’t answering, so these are its newest matches, not its closest.'|t({'@label': label}) }}</p>
    {% endif %}
    <ol class="pf-index-list__rows" role="list"{% if holdings_url %} data-pf-index-holdings-url="{{ holdings_url }}"{% endif %}>
      {% for item in items %}
        <li class="pf-index-row{{ item.image or item.image_url ? ' pf-index-row--image' }}">
          <div class="pf-index-row__text">
          {% if item.type or item.source or item.login %}
            <p class="pf-index-row__tags">
              {% if item.type or item.source %}<span class="pf-index-row__type">{{ item.source ?: item.type }}</span>{% endif %}
              {% if item.login %}<span class="pf-index-row__login"><span class="pf-index-row__login-out"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="5" y="11" width="14" height="9"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>{{ 'LSU login'|t }}<span class="visually-hidden"> {{ 'required'|t }}</span></span><span class="pf-index-row__login-in"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m5 12.5 4.5 4.5L19 7.5"/></svg>{{ 'Signed in'|t }}</span></span>{% endif %}
            </p>
          {% endif %}
          <h3 class="pf-index-row__title">
            <a href="{{ item.url }}">{{ item.title }}{% if item.external %}<svg class="pf-index-row__out" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M7 17 17 7M9 7h8v8"/></svg><span class="visually-hidden"> {{ '(another site)'|t }}</span>{% endif %}</a>
          </h3>
          {% if item.meta %}
            <p class="pf-index-row__meta">{{ item.meta }}</p>
          {% endif %}
          {% if item.summary|render %}
            <p class="pf-index-row__summary">{{ item.summary }}</p>
          {% endif %}
          {# Words around the match inside the record itself, so it's plain the
             search reads the whole PDF, not only the description. #}
          {% if item.excerpt|render %}
            <p class="pf-index-row__excerpt"><span class="pf-index-row__excerpt-label">{{ item.url ends with '.pdf' ? 'Found in the PDF'|t : 'Found in the full text'|t }}</span> {{ item.excerpt }}</p>
          {% endif %}
          {# A record that is a PDF: a button as clear as a catalog row's Show
             location. A new tab, so the results stay where they were. Its length
             beside it, so it's plain what opening it means. #}
          {% if item.url ends with '.pdf' %}
            <p class="pf-index-row__open"><a class="pf-button--secondary" href="{{ item.url }}" target="_blank" data-no-swup>{{ 'Open PDF'|t }}<span class="visually-hidden">: {{ item.title|striptags }} {{ '(opens in a new tab)'|t }}</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5M9 13h6M9 17h4"/></svg></a>
              {%- if item.pdf.size %}
                {% set pages = item.pdf.pages %}
                <span class="pf-index-row__pdf">{% if pages %}{% trans %}{{ pages }} page{% plural pages %}{{ pages }} pages{% endtrans %} · {% endif %}{{ item.pdf.size }}</span>
              {%- endif %}</p>
          {% endif %}
          {% if item.full_text_url %}
            <p class="pf-index-row__links"><a href="{{ item.full_text_url }}">{{ 'Full text'|t }}<span class="visually-hidden">: {{ item.title|striptags }} {{ '(another site)'|t }}</span><svg class="pf-index-row__out" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M7 17 17 7M9 7h8v8"/></svg></a></p>
          {% endif %}
          {% if item.details %}
            <details class="pf-index-row__details">
              <summary><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m9 6 6 6-6 6"/></svg>{{ 'Book details'|t }}{% if item.details|length > 1 %} · {{ '@count sections'|t({'@count': item.details|length}) }}{% endif %}</summary>
              <div class="pf-index-row__label">
                {% if item.image_url %}
                  <div class="pf-index-row__label-cover"><img src="{{ item.image_url }}" alt="" width="180" height="270" loading="lazy" decoding="async" referrerpolicy="no-referrer"></div>
                {% endif %}
                <ul class="pf-index-row__copies" role="list">
                  {% for copy in item.details %}
                    <li>
                      <dl>
                        {% if copy.class %}<div><dt>{{ 'Class'|t }}</dt><dd>{{ copy.class }}</dd></div>{% endif %}
                        {% if copy.instructor %}<div><dt>{{ 'Instructor'|t }}</dt><dd>{% if copy.instructor_is_email %}<a href="mailto:{{ copy.instructor }}">{{ copy.instructor }}</a>{% else %}{{ copy.instructor }}{% endif %}</dd></div>{% endif %}
                        {% if copy.section %}<div><dt>{{ 'Section'|t }}</dt><dd>{{ copy.section }}</dd></div>{% endif %}
                        {% if copy.term %}<div><dt>{{ 'Term'|t }}</dt><dd>{{ copy.term }}</dd></div>{% endif %}
                      </dl>
                    </li>
                  {% endfor %}
                </ul>
              </div>
            </details>
          {% endif %}
          </div>
          {% if item.image %}
            <div class="pf-index-row__thumb">{{ item.image }}</div>
          {% elseif item.image_url %}
            <div class="pf-index-row__thumb pf-index-row__thumb--cover"><img src="{{ item.image_url }}" alt="" width="88" height="110" loading="lazy" decoding="async" referrerpolicy="no-referrer"></div>
          {% endif %}
          {% if item.holdings_id %}
            <div class="pf-index-row__holdings" data-pf-index-holdings="{{ item.holdings_id }}"></div>
          {% endif %}
        </li>
      {% endfor %}
    </ol>
    {% if limited %}
      <p class="pf-index-list__status">{{ 'Only the first @count results can be shown here. Narrow the search, or see them all on the service’s own site.'|t({'@count': limited|number_format}) }}</p>
    {% endif %}
    {% if more_url %}
      <p class="pf-index-list__more" data-no-swup><a class="pf-index-rule__link" href="{{ more_url }}">{{ more_label }}</a></p>
    {% endif %}
    {% if pager %}<div class="pf-index-list__pager" data-no-swup>{{ pager }}</div>{% endif %}
  {% endif %}
</div>
