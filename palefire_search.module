<?php

/**
 * @file
 * The Index: the Palefire search page at /v2/search.
 */

use Drupal\Core\Breadcrumb\Breadcrumb;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Link;
use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\Core\Url;

/**
 * Implements hook_theme().
 */
function palefire_search_theme(): array {
  return [
    'palefire_search' => [
      'variables' => [
        'query' => '',
        'mode' => 'all',
        'modes' => [],
        'filters' => [],
        'chips' => [],
        'clear_url' => NULL,
        'selected_count' => 0,
        'total' => NULL,
        'capped' => FALSE,
        'sort' => NULL,
        'sorts' => [],
        'links' => [],
        'sections' => [],
        'list' => NULL,
        'list_title' => NULL,
        'list_source' => NULL,
        'via' => NULL,
        'notice' => NULL,
        'answer' => NULL,
        'action' => '',
        'kept' => [],
        'feedback' => NULL,
      ],
    ],
    'palefire_search_holdings' => [
      'variables' => [
        'records' => [],
      ],
    ],
    'palefire_search_list' => [
      'variables' => [
        'label' => '',
        'total' => NULL,
        'count' => '',
        'items' => [],
        'journal' => NULL,
        'failed' => FALSE,
        'simplified' => NULL,
        'backup' => FALSE,
        'holdings_url' => NULL,
        'limited' => NULL,
        'more_url' => NULL,
        'more_label' => NULL,
        'more_name' => NULL,
        'more_count' => NULL,
        'pager' => NULL,
      ],
    ],
  ];
}

/**
 * Implements hook_cron().
 *
 * Keeps the Scholarly Repository's records current a few pages at a time
 * (RepositoryHarvest::cron()). The first full harvest is quicker with drush.
 */
function palefire_search_cron(): void {
  \Drupal::service('palefire_search.repository_harvest')->cron();
}

/**
 * Implements hook_system_breadcrumb_alter().
 *
 * The Index in its Special Collections mode sits under Special Collections, so
 * a search from that page has a way back to it. Read from the address, so a
 * shared link shows the same trail.
 */
function palefire_search_system_breadcrumb_alter(Breadcrumb &$breadcrumb, RouteMatchInterface $route_match, array $context): void {
  if ($route_match->getRouteName() !== 'palefire_search.page') {
    return;
  }
  $breadcrumb->addCacheContexts(['url.query_args:mode']);
  if (\Drupal::request()->query->get('mode') === 'special') {
    $breadcrumb->addLink(Link::fromTextAndUrl(t('Special Collections'), Url::fromUserInput('/v2/special')));
  }
}

/**
 * Implements hook_ENTITY_TYPE_presave() for webform_submission.
 *
 * Combined Search feedback is anonymous for everyone: Webform notes the
 * signed-in account with each response, so this one is saved without it. Its
 * IP address is never kept (the form's own setting). Only whether the visitor
 * was signed in to the website is kept (signed_in: yes or no), read here
 * rather than sent by the page, and only when the response is first saved:
 * a later edit in the Results tab is someone else's session.
 */
function palefire_search_webform_submission_presave(EntityInterface $submission): void {
  if ($submission->get('webform_id')->target_id !== 'combined_search_feedback') {
    return;
  }
  if ($submission->isNew()) {
    $submission->setElementData('signed_in', \Drupal::currentUser()->isAuthenticated() ? 'yes' : 'no');
  }
  $submission->set('uid', 0);
}
