        'selected_count' => 0,
        'total' => NULL,
        'capped' => FALSE,
        'sort' => NULL,
        'sorts' => [],
        'links' => [],
        'sections' => [],
        'list' => NULL,
        'list_title' => NULL,
        'list_source' => NULL,
        'via' => NULL,
        'notice' => NULL,
        'action' => '',
      ],
    ],
    'palefire_search_holdings' => [
      'variables' => [
        'records' => [],
      ],
    ],
    'palefire_search_list' => [
      'variables' => [
        'label' => '',
        'total' => NULL,
        'items' => [],
        'failed' => FALSE,
        'simplified' => NULL,
        'backup' => FALSE,
        'holdings_url' => NULL,
        'limited' => NULL,
        'more_url' => NULL,
        'more_label' => NULL,
        'pager' => NULL,
      ],
